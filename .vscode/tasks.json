{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Regenerate Highlighting",
            "type": "shell",
            // npm install is a fast no-op once node_modules matches package-lock.json,
            // so this stays cheap on every Serve run while still working on a fresh
            // clone. Needs BitMagic.VSC checked out as a sibling of this repo (see
            // tools/highlight/render.mjs) -- the normal superproject layout.
            //
            // pwsh (PS7), not powershell.exe (Windows PowerShell 5.1, used by the Serve
            // task below): 5.1 doesn't support && as a statement separator, and npm on
            // Windows is an npm.ps1 script that 5.1's default execution policy refuses
            // to run at all. Neither restriction applies to pwsh.
            "command": "npm install && npm run build",
            "options": {
                "cwd": "${workspaceFolder}/tools/highlight",
                "shell": {
                    "executable": "pwsh.exe",
                    "args": ["-NoProfile", "-Command"]
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Serve",
            "type": "shell",
            "command": "bundle exec jekyll serve --livereload",
            // Force a Windows shell: the Ruby toolchain (bundle/jekyll) lives on the
            // Windows PATH. Without this the task inherits the default terminal
            // profile, and if that is WSL it fails with:
            //   execvpe(bundle) failed: No such file or directory
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-NoProfile", "-Command"]
                }
            },
            "dependsOn": ["Regenerate Highlighting"],
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
